node_modules/
# The trailing-slash rule above matches directories only; also ignore the
# root and mobile `node_modules` symlinks so they can't be committed again.
/node_modules
/mobile/node_modules
dist/
# `npm run build:app` output and the Playwright smoke suite's results
dist-app/
playwright-report/
test-results/
*.log
.DS_Store

# Generated trail data (built from source)
public/data/generated/
src/web/trails/*/

# Te Araroa route data, materialised from the te-araroa-data package by
# `npm run sync:te-araroa`. Upstream commits its build outputs and the lockfile
# pins the commit, so a copy here would be a second, drifting source of truth.
data/trails/te_araroa/te-araroa-sobo.gpx

# Tile pipeline data (large files, built from source)
data/dem/
data/dem-glo30/
data/protomaps/
data/tiles/
data/experiments/
public/data/tiles/
aus-map-data/

# Remote build logs + generated shard runners (contours/scripts/remote/run-shard.sh)
logs/

# Override global gitignore `lib/` rule for source code
!src/lib/
!mobile/src/lib/

# Claude Code local settings (per-user, not shared)
.claude/settings.local.json

# Environment files
.env
.env.local
.env*.local
.vercel
.wrangler

# Claude Code session worktrees (agent scratch space)
.claude/worktrees/

# The waypoint editor's saves write each file to a temporary one beside it and
# rename it over (`.<file>.<pid>-<n>.wpe-tmp`, with a `.wpe-bak` copy of the old
# file until the save is through). One left by a dev server killed mid-save is
# never trail data: keep it out of commits and of the editor's changed-files list.
*.wpe-tmp
*.wpe-bak

# Overpass answers cached by fetch-access.ts
data/osm-ways-cache/
